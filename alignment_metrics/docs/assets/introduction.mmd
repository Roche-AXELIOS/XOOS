---
config:
  htmlLabels: false
  theme: base
  themeVariables:
    background: "#ffffff"
    primaryColor: "#e3f2fd"
    primaryBorderColor: "#90caf9"
    primaryTextColor: "#1a1a1a"
    lineColor: "#546e7a"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#f5f5f5"
    clusterBorder: "#bdbdbd"
    secondaryColor: "#e8f5e9"
    tertiaryColor: "#f5f5f5"
---
graph TD
    BED@{shape: doc, label: Optional Target BED}
    Ref@{shape: doc, label: Reference FASTA}
    BAM@{shape: doc, label: Input BAM}
    BAM --> AlignmentMetrics
    BED -..-> AlignmentMetrics
    Ref -.if homopolymer coverage requested.-> CoverageMetrics
    Ref ---> AccuracyMetrics
    subgraph AlignmentMetrics[ ]
    CoverageMetrics[Coverage Metrics]
    AccuracyMetrics[Accuracy Metrics]
    ReadMetrics[Read Metrics]
    end
    ReadMetrics --> Output@{shape: docs, label: Output Metrics}
    CoverageMetrics --> Output
    AccuracyMetrics --> Output
