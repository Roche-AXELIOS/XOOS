/*
    AWS Batch execution template.
    Replace every deployment and queue placeholder before use.
    Copy to your profile's .config file and use the matching YAML template.
    This example uses on-demand queues. Configure retry behavior if using
    interruptible capacity.
*/
profiles {
    <PROFILE_NAME> {
        aws {
            batch {
                jobRole = '<AWS_IAM_ROLE_ARN>'
                cliPath = '<AWS_CLI_PATH>'
                terminateUnschedulableJobs = true
                maxParallelTransfers = 16
                maxTransferAttempts = 3
                delayBetweenAttempts = '15 sec'
            }
            client {
                maxConnections = 100
            }
            region = '<AWS_REGION>'
        }

        validation {
          ignoreParams = ['error_strategy_fallback']
        }

        process {
            executor = 'awsbatch'
            maxRetries = 3
            errorStrategy = { task.exitStatus == null || task.exitStatus in (135..140) + [255] ? 'retry' : params.getOrDefault('error_strategy_fallback', 'ignore') }

            // Set limits to the maximum resources available across configured queues.
            resourceLimits = [
                memory: <MAX_MEMORY>.GB,
                cpus: <MAX_CPUS>,
                time: <MAX_TIME>.h
            ]

            cpus   = 1
            memory = { Math.min(2 * task.attempt, 4).GB }
            time   = { 4.h  * task.attempt }
            // NOTE: Set memory thresholds below the instance's total RAM to
            // account for ECS agent overhead (~0.5-1 GB). For example, a 4 GB
            // instance can only run containers up to ~3 GB.
            queue  = {
                def memGB  = task.memory.toGiga()
                def diskGB = task.disk ? task.disk.toGiga() : 500
                // Large-disk requests route to dedicated queues, sized by CPU/memory
                // to limit co-scheduling and prevent shared-disk exhaustion.
                if (diskGB > 2048) return '<LARGE_QUEUE_NAME>'
                if (diskGB > 500) {
                    if (task.cpus <= 4  && memGB <= 7)  return '<XLARGE_LARGE_DISK_QUEUE_NAME>'
                    if (task.cpus <= 8  && memGB <= 15) return '<TWO_XLARGE_LARGE_DISK_QUEUE_NAME>'
                    if (task.cpus <= 16 && memGB <= 31) return '<FOUR_XLARGE_LARGE_DISK_QUEUE_NAME>'
                    if (task.cpus <= 32 && memGB <= 63) return '<EIGHT_XLARGE_LARGE_DISK_QUEUE_NAME>'
                    return '<LARGE_QUEUE_NAME>'
                }
                if (task.cpus <= 2  && memGB <= 3)  return '<SMALL_QUEUE_NAME>'
                if (task.cpus <= 16 && memGB <= 32) return '<MEDIUM_QUEUE_NAME>'
                if (task.cpus <= 32 && memGB <= 64) return '<EIGHT_XLARGE_QUEUE_NAME>'
                return '<LARGE_QUEUE_NAME>'
            }

            withLabel:process_single {
                cpus   = 1
                memory = { 1.GB   * task.attempt }
                time   = { 4.h    * task.attempt }
                disk   = 500.GB
            }

            withLabel:process_low {
                cpus   = 2
                memory = { 4.GB   * task.attempt }
                time   = { 4.h    * task.attempt }
                disk   = 500.GB
            }

            withLabel:process_medium {
                cpus   = 8
                memory = { 16.GB  * task.attempt }
                time   = { 8.h    * task.attempt }
                disk   = 500.GB
            }

            withLabel:process_high {
                cpus   = 32
                memory = { 48.GB  * task.attempt }
                time   = { 16.h   * task.attempt }
                disk   = 500.GB
            }

            withLabel:process_high_memory {
                cpus   = 32
                memory = { Math.min(120 * task.attempt, 120).GB }
                time   = { 16.h   * task.attempt }
                disk   = 8192.GB
            }

            withLabel:process_gpu {
                queue = '<GPU_QUEUE_NAME>'
                accelerator = 1
                cpus = 64
                memory = 240.GB
            }

            // Whole-run Parabricks alignment can exceed the process_high
            // default for large duplex input runs. Cap retries at the 48-hour
            // profile resource limit.
            withName: PARABRICKS_FQ2BAM_SINGLE_END_MULTIPLE_FASTQS {
                time = { Math.min(20 * task.attempt, 48).h }
            }

            // --- Process-name overrides for cost optimization ---

            withName: KMC_KMER_COUNT {
                cpus   = 12
                memory = { 24.GB * task.attempt }
                time   = { 2.h   * task.attempt }
                disk   = 500.GB
            }

            withName: VG_HAPLOTYPES {
                cpus   = 8
                memory = { Math.min(48 * task.attempt, 120).GB }
                time   = { 2.h   * task.attempt }
                disk   = 500.GB
            }

            withName: VG_GIRAFFE {
                cpus   = 32
                memory = { Math.min(100 * task.attempt, 120).GB }
                time   = { 1.d   * task.attempt }
                disk   = 500.GB
            }

            withName: VG_AUTOINDEX {
                cpus   = 6
                memory = { Math.min(96 * task.attempt, 120).GB }
                time   = { 2.h   * task.attempt }
                disk   = 500.GB
            }

            withName: 'BCFTOOLS_CONCAT' {
                cpus   = 2
                memory = { 4.GB   * task.attempt }
            }

            withName: 'XOOS_READ_COLLAPSER_MARK_DUPLICATES' {
                cpus   = 16
                memory = { 16.GB  * task.attempt }
                disk   = 1000.GB
            }

            withName: 'XOOS_READ_COLLAPSER_RESCUE_SECONDARY' {
                cpus   = 8
                memory = { Math.min(32 * task.attempt, 120).GB }
                disk   = 1000.GB
            }

            withName: 'XOOS_SMALL_VARIANT_CALLER_COMPUTE_VCF_FEATURES' {
                cpus   = 8
                memory = { 8.GB   * task.attempt }
            }

            withName: 'XOOS_ALIGNMENT_METRICS_ALL|XOOS_ALIGNMENT_METRICS_COVERAGE' {
                cpus   = 16
                memory = { 16.GB  * task.attempt }
            }

            withName: 'XOOS_COPY_NUMBER_CALLER_GERMLINE_WGS' {
                cpus   = 16
                memory = { 16.GB  * task.attempt }
            }

            withName: 'XOOS_COPY_NUMBER_CALLER_TUMOR_NORMAL_WGS' {
                cpus   = 24
                memory = { 24.GB  * task.attempt }
            }

            withName: GATK4_MUTECT2 {
                cpus   = 4
                memory = { 16.GB * task.attempt }
                time   = { 8.h  * task.attempt }
            }

            withName: 'PARABRICKS_MUTECTCALLER' {
                // 96 GB fits within the GPU instance memory; resourceLimits
                // caps the request to instance capacity as a safety net.
                memory = 96.GB
                time   = { 2.d  * task.attempt }
            }

            withName: XOOS_DEMUX {
                cpus   = 48
                memory = { Math.min(64 * task.attempt, 120).GB }
                time   = { 1.d   * task.attempt }
                disk   = 3000.GB
            }

            // Run-level tasks operate on a whole run rather than a single
            // sample, so a failure here compromises every downstream sample.
            // Use 'finish' instead of the configurable global error_strategy_fallback
            // (default 'ignore') so a failure stops the run.
            withName: 'XOOS_DEMUX|SUBSAMPLE_BASECALL_RDB|SUBSAMPLE_BASECALL_FASTQ|XOOS_GENERATE_REPORT|XOOS_GENERATE_REPORT_SUMMARY|MULTIQC' {
                errorStrategy = { task.exitStatus == null || task.exitStatus in (135..140) + [255] ? 'retry' : 'finish' }
            }

            withName: VERIFY_CRAM {
                errorStrategy = { task.exitStatus == null || task.exitStatus in (135..140) + [255] ? 'retry' : 'terminate' }
            }

            withName: XOOS_STR_CALLER {
                memory = { 16.GB * task.attempt }
            }

            withName: SAMBAMBA_MERGE {
                disk  = 2048.GB
            }

            withName: SAMTOOLS_VIEW {
                cpus   = 4
                memory = { 4.GB  * task.attempt }
                time   = { 8.h   * task.attempt }
            }

            withName: SAMTOOLS_CONVERT {
                cpus   = 8
                memory = { 16.GB  * task.attempt }
                time   = { 8.h   * task.attempt }
                disk   = 500.GB
            }

            withName: '.*SUBSAMPLE_BAM:SAMTOOLS_VIEW' {
                disk  = 2048.GB
            }

            withName: 'XOOS_SMALL_VARIANT_CALLER_FILTER_VARIANTS_TUMOR_NORMAL_WGS' {
                cpus   = 16
                memory = { Math.min(96 * task.attempt, 120).GB }
            }

            withName: 'XOOS_SMALL_VARIANT_CALLER_FILTER_VARIANTS_TUMOR_ONLY_WGS' {
                cpus   = 16
                memory = { Math.min(96 * task.attempt, 120).GB }
            }

            withName: 'XOOS_COPY_NUMBER_CALLER_TUMOR_ONLY_WGS' {
                cpus   = 24
                memory = { 24.GB  * task.attempt }
            }

            withName: 'XOOS_GERMLINE_FILTERING' {
                cpus   = 8
                memory = { 16.GB  * task.attempt }
                time   = { 2.h    * task.attempt }
            }

            withName: 'PICARD_COLLECT_GC_BIAS_METRICS' {
                memory = { Math.min(16 * task.attempt, 60).GB }
                disk   = 2048.GB
            }

            withName: 'XOOS_CONTAMINATION_DETECTOR' {
                cpus   = 24
                memory = { 48.GB * task.attempt }
            }
        }
    }
}
