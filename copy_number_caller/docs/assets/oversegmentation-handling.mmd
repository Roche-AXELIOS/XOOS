config:
  htmlLabels: false
  theme: base
  themeVariables:
    background: "#ffffff"
    primaryColor: "#e3f2fd"
    primaryBorderColor: "#90caf9"
    primaryTextColor: "#1a1a1a"
    lineColor: "#546e7a"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#f5f5f5"
    clusterBorder: "#bdbdbd"
    secondaryColor: "#e8f5e9"
    tertiaryColor: "#f5f5f5"
---
graph TD
    %% Node Definitions
    Q2{"`Greater than
--max-segments-for-undoing?`"}

    %% Logic Flow
    Q2 -- True --> Increase["`Increase
--initial-segment-undoing-factor by --segment-undoing-increment`"]
    Q2 -- False --> Continue

    Increase -- Segment undo --> Q2

    %% Styling
    style Q2 fill:#c6e2ff,stroke:#333
    style Increase fill:#f5bca9,stroke:#333
