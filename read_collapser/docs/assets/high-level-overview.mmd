config:
  htmlLabels: false
  theme: base
  themeVariables:
    background: "#ffffff"
    primaryColor: "#e3f2fd"
    primaryBorderColor: "#90caf9"
    primaryTextColor: "#1a1a1a"
    lineColor: "#546e7a"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#f5f5f5"
    clusterBorder: "#bdbdbd"
    secondaryColor: "#e8f5e9"
    tertiaryColor: "#f5f5f5"
---
flowchart TD
    BamInput[/BAM file/] --> UMIType{"`Is cluster
by umi
enabled?`"}
    BedInput[/Optional BED file/] -.-> UMIType

    subgraph Clustering["Clustering"]
        direction TD
        UMIType --> | yes | UMICluster(Cluster by UMI)
        UMIType --> | no | SepByStrand{"`Is cluster
by strand
enabled?`"}
        UMICluster --> SepByStrand
        SepByStrand --> | yes | StrandPosCluster(Cluster by position and strand)
        SepByStrand --> | no | PosCluster(Cluster by position only)
    end

    PosCluster --> Modes{"`Which subcommand
has been specified?`"}
    StrandPosCluster --> Modes
    Modes --> MarkDups[markdup]
    Modes --> Consensus[consensus]
    MarkDups --> BamOutput[/BAM output files/]
    MarkDups --> MetricOutput[/Metric output files/]
    Consensus --> FastqOutput[/FASTQ output files/]
    Consensus --> MetricOutput
