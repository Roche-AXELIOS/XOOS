---
config:
  htmlLabels: false
  theme: base
  themeVariables:
    background: "#ffffff"
    primaryColor: "#e3f2fd"
    primaryBorderColor: "#90caf9"
    primaryTextColor: "#1a1a1a"
    lineColor: "#546e7a"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#f5f5f5"
    clusterBorder: "#bdbdbd"
    secondaryColor: "#e8f5e9"
    tertiaryColor: "#f5f5f5"
---
flowchart TD
    BamInput[/BAM input: aligned reads/] --> Collated{"`Is --collated
enabled?`"}

    subgraph CollatedMode["Collated mode"]
        direction TD
        SinglePass["`Single-pass scan:
read one QNAME group`"]
        PrimaryUnmapped{"`Primary alignment
unmapped?`"}
        CollatedWrite["`Write primary and
supplementary records`"]
        CollatedCandidates["`Check mapped secondary
alignments in the group`"]
        SinglePass --> PrimaryUnmapped
        PrimaryUnmapped -->|No| CollatedWrite
        PrimaryUnmapped -->|Yes| CollatedCandidates
    end

    subgraph DefaultMode["Default mode"]
        direction TD
        Pass1["`Pass 1:
record QNAMEs whose
primary is unmapped`"]
        Pass2["`Pass 2:
re-scan BAM records`"]
        DefaultWrite["`Write primary and
supplementary records`"]
        DefaultCandidates["`Check secondary records
for flagged QNAMEs`"]
        Pass1 --> Pass2
        Pass2 --> DefaultWrite
        Pass2 --> DefaultCandidates
    end

    Collated -->|Yes| SinglePass
    Collated -->|No| Pass1

    CollatedCandidates --> Eligible{"`Mapped secondary has AS tag
and AS / read length ≥ min ratio?`"}
    DefaultCandidates --> Eligible

    Eligible -->|No| Drop[/Omit secondary\nfrom output/]
    Eligible -->|Yes, first eligible only| Tag["`Tag rescued secondary
with YF:i:1`"]

    Tag --> BamOut[/Write rescued_secondary.bam/]
    CollatedWrite --> BamOut
    DefaultWrite --> BamOut

    BamOut --> Metrics[/Write rescue_secondary_metrics.tsv/]
