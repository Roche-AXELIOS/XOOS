---
config:
  htmlLabels: false
  theme: base
  themeVariables:
    background: "#ffffff"
    primaryColor: "#e3f2fd"
    primaryBorderColor: "#90caf9"
    primaryTextColor: "#1a1a1a"
    lineColor: "#546e7a"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#f5f5f5"
    clusterBorder: "#bdbdbd"
    secondaryColor: "#e8f5e9"
    tertiaryColor: "#f5f5f5"
---
graph TB
    subgraph VPC["VPC (10.0.0.0/16)"]
        IGW["Internet Gateway"]
        RT["Route Table"]
        subgraph Subnets["Subnets (one per AZ)"]
            S1["Subnet 10.0.0.0/24"]
        end
        SG["`Security Group
(egress-only)`"]
    end

    subgraph IAM["IAM Roles"]
        WR["`Batch Worker Role
(ECS container service)`"]
        IP["Instance Profile"]
        DR["`Driver Role
(Batch + S3 + KMS + PassRole)`"]
        DAR["`Data All-Access Role
(S3 + KMS full access)`"]
        SFR["`Spot Fleet Role
(per SPOT compute env)`"]
    end

    subgraph Compute["Batch Compute (per compute_resources entry)"]
        LT["`Launch Template
(EBS, userdata, metadata)`"]
        CE["`Compute Environment
(SPOT or EC2)`"]
        JQ["Job Queue"]
    end

    subgraph Storage["Storage"]
        S3["`S3 Data Bucket
(versioned, KMS-encrypted,
intelligent tiering)`"]
        KMS["KMS Key"]
    end

    subgraph Notifications["Notifications"]
        SQS["SQS Queue"]
        CW["`CloudWatch Event Rules
(Batch job state changes)`"]
    end

    IGW --> RT
    RT --> S1
    WR --> IP
    IP --> CE
    SG --> CE
    S1 --> CE
    LT --> CE
    CE --> JQ
    KMS --> S3
    CW --> SQS
    JQ --> CW
