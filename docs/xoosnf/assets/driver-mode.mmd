---
config:
  htmlLabels: false
  theme: base
  themeVariables:
    background: "#ffffff"
    primaryColor: "#e3f2fd"
    primaryBorderColor: "#90caf9"
    primaryTextColor: "#1a1a1a"
    lineColor: "#546e7a"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#f5f5f5"
    clusterBorder: "#bdbdbd"
    secondaryColor: "#e8f5e9"
    tertiaryColor: "#f5f5f5"
---
sequenceDiagram
    participant User as Login node
    participant Launcher as xoos run --env my_cluster
    participant Slurm as sbatch
    participant Driver as Compute node
    participant NF as Nextflow

    User->>Launcher: xoos run --env my_cluster
    Launcher->>Launcher: Generate driver script
    Launcher->>Slurm: sbatch driver.sh
    Slurm->>Driver: Allocate node, run driver.sh
    Driver->>Driver: xoos run --env my_cluster --driver-mode
    Driver->>NF: Launch Nextflow (local executor)
    NF->>Slurm: Submit pipeline tasks via Slurm
